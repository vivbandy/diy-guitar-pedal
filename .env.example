# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- LLM backend ---
TONE_BACKEND=cloud            # cloud | local
ANTHROPIC_API_KEY=            # required when TONE_BACKEND=cloud
TONE_CLOUD_MODEL=claude-opus-5
TONE_CLOUD_EFFORT=medium      # low | medium | high | xhigh | max

# local backend (llama.cpp `llama-server`)
TONE_LOCAL_URL=http://127.0.0.1:8080/v1
TONE_LOCAL_MODEL=qwen3-8b-instruct
TONE_LOCAL_GRAMMAR=0          # 1 to use prompts/grammar/patch.gbnf instead of a JSON Schema

# --- data source ---
TONE_SOURCE=file              # file | supabase
SUPABASE_URL=
SUPABASE_KEY=                 # treat like a password

# --- TONE3000 (optional) ---
TONE3000_TOKEN=

# --- limits ---
TONE_MAX_REPAIR_ATTEMPTS=2
TONE_MAX_CANDIDATES=24
TONE_MAX_RECIPES=3
